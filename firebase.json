{
  "hosting": {
    "site": "directorcutpro",
    "public": "editor-dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/editor.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8088
    },
    "storage": {
      "port": 9198
    },
    "auth": {
      "port": 9098
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Allow public read to everything by default
    match /{folder}/{allPaths=**} {
      allow read: if folder != 'DCP';
      allow write: if folder != 'DCP' && request.auth != null;
    }
    
    match /collections_onboarding/{allPaths=**} {
      allow read, write: if true;
    }

    // // Require auth for profile_images
    // match /profile_images/{file} {
    //   allow read, write: if request.auth != null;
    // }

//     // Require auth for gifs
//     match /gifs/{file} {
//       allow read, write: if request.auth != null;
//     }

//     // Require auth for soundtracks
//     match /soundtracks/{file} {
//       allow read, write: if request.auth != null;
//     }

    match /DCP/{uid}/{category}/{file} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      allow read, delete: if isOwner();
      allow create: if isOwner() && request.resource.size <= 2147483648
        && ((category == 'video' && request.resource.contentType.matches('video/.*'))
          || (category == 'audio' && request.resource.contentType.matches('audio/.*'))
          || (category == 'img' && request.resource.contentType.matches('image/.*')));
      allow update: if false;
    }
    // Optionally: lock down write access to other public folders if needed
    // match /infinityCardImages/{file} {
    //   allow write: if request.auth != null; // Optional
    // }
  }
}

